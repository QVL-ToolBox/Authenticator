# Secrets du service d'authentification : copier vers .env (jamais commité).

# Signature des JWT (HS256). Obligatoire, au moins 32 octets. Générer avec : openssl rand -hex 32
JWT_SECRET=

# Base MongoDB, nom de la base dans le chemin. Valeur pour cargo run ; le docker-compose la remplace par mongodb://mongo:27017/auth.
MONGO_URI=mongodb://localhost:27017/auth

# Facultatif : active POST /internal/users/resolve (en-tête x-internal-secret). Au moins 32 octets, distinct de JWT_SECRET.
# INTERNAL_API_SECRET=

# Premier administrateur, créé au démarrage s'il n'existe pas (seed idempotent). Laissés vides : aucun admin créé.
ADMIN_EMAIL=admin@example.com
# 12 caractères minimum, une majuscule, une minuscule, un chiffre, un caractère spécial, absent des listes de mots de passe compromis.
ADMIN_PASSWORD=

# dev ou prod (prod force Secure sur les cookies et interdit tls = "none").
APP__ENVIRONMENT=dev
